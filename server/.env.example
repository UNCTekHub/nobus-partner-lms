PORT=3001
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
DB_PATH=./data/lms.db

# Public base URL of the portal - used to build links in emails.
PLATFORM_URL=https://your-portal-domain

# Email delivery (SMTP). When these are set, the platform starts sending the
# notification emails; when unset, emails are safely skipped (logged only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Nobus PartnerCentral
SMTP_FROM_EMAIL=noreply@nobus.io
